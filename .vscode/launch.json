{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar Backend (NestJS)",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/backend/src/main.ts"],
      "runtimeArgs": ["-r", "ts-node/register", "-r", "tsconfig-paths/register"],
      "cwd": "${workspaceFolder}/backend",
      "protocol": "inspector",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Depurar Frontend (Angular Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Iniciar Frontend (Angular)",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full-Stack (Backend + Frontend)",
      "configurations": ["Depurar Backend (NestJS)", "Depurar Frontend (Angular Chrome)"]
    }
  ]
}
